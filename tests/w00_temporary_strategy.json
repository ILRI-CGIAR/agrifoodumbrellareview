{
  "schema": "evidence-search-strategy-v1",
  "project_id": "generic-smoketest",
  "search_version": "smoke-v1",
  "sources": {
    "scopus": {
      "database_name": "Scopus",
      "platform": "Elsevier Scopus API",
      "backend": "scopus",
      "search_fields": [
        "title",
        "abstract",
        "keywords"
      ],
      "queries": {
        "full": {
          "query": "TITLE-ABS-KEY(synthetic)"
        },
        "monthly": {
          "query": "TITLE-ABS-KEY(synthetic) AND ORIG-LOAD-DATE AFT 20261101",
          "filter": {
            "load_after": "2026-11-01"
          },
          "window": {
            "from": "2026-11-01",
            "to": "2026-11-08"
          }
        }
      }
    },
    "wos": {
      "database_name": "Web of Science Core Collection",
      "platform": "Web of Science Starter",
      "backend": "wos",
      "search_fields": [
        "title",
        "abstract",
        "author_keywords"
      ],
      "queries": {
        "full": {
          "query": "TI=(synthetic)"
        },
        "monthly": {
          "query": "TI=(synthetic)",
          "filter": {
            "modified_time_span": "2026-11-01/2026-11-08"
          },
          "window": {
            "from": "2026-11-01",
            "to": "2026-11-08"
          }
        }
      }
    }
  }
}
